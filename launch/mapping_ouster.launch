<launch>
  <!-- 1. Common mapping args -->
  <arg name="rviz"           default="false"/>
  <arg name="bag_file"       default=""/>
  <arg name="metadata_file"  default="$(find coin_lio)/config/os1-64-1024x20.json"/>
  <arg name="column_shift"   default="4"/>
  <arg name="point_topic"    default="/ouster/points"/>
  <arg name="imu_topic"      default="/ouster/imu"/>
  <arg name="destagger"      default="false"/>



  <!-- 4. Load all ROS parameters -->
  <rosparam file="$(find coin_lio)/config/params.yaml"    command="load"/>
  <rosparam file="$(find coin_lio)/config/line_removal.yaml" command="load"/>
  <!-- metadata_file here is a JSON, but if coin_lio expects its values loaded via params, keep this -->
  <rosparam file="$(arg metadata_file)" command="load"/>

  <!-- 5. Override any common parameters via args -->
  <param name="common/lid_topic"   type="string" value="$(arg point_topic)"/>
  <param name="common/imu_topic"   type="string" value="$(arg imu_topic)"/>
  <param name="image/u_shift"      type="int"    value="$(arg column_shift)"/>
  <param name="image/destagger"    type="bool"   value="$(arg destagger)"/>

  <!-- 6. The single mapping node -->
  <!-- LD_PRELOAD forces OpenCV 4.5 to prevent ABI conflict with 4.2 pulled in by cv_bridge -->
  <node pkg="coin_lio" type="coin_lio_mapping" name="laserMapping" output="screen">
    <env name="LD_PRELOAD" value="/usr/lib/aarch64-linux-gnu/libopencv_imgproc.so.4.5 /usr/lib/aarch64-linux-gnu/libopencv_core.so.4.5"/>
  </node>

  <!-- 7. RViz (only if requested) -->
  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find coin_lio)/rviz_cfg/coinlio_viz.rviz"/>
  </group>

  <!-- 8. Bag playback (only if bag_file is set) -->
  <group unless="$(eval arg('bag_file') == '')">
    <node pkg="rosbag" type="play" name="player" output="screen"
          args="--clock --quiet $(arg bag_file) -d 2 --queue=1000"/>
  </group>
</launch>